     char* m_imageData = nullptr;
     uint32_t m_imageSize = 0;
     XImage* m_image = nullptr;
+    // patch local : ne prendre le fond du bureau qu'après N images rendues (bascule sans trou)
+    mutable int m_framesRendered = 0;
     std::vector<OutputViewport*> m_screens = {};
 };
